{
  "name": "cmms-faeterj",
  "version": "1.0.0",
  "description": "Sistema CMMS para Gestão de Manutenção Fabril (FAETERJ Barra Mansa)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "npm run migrate --workspace=backend",
    "migrate:rollback": "npm run migrate:rollback --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "test:backend": "npm run test --workspace=backend"
  },
  "keywords": [
    "cmms",
    "manutencao-industrial",
    "faeterj",
    "tcc"
  ],
  "author": "Iury Lopes",
  "license": "ISC"
}
